# URL informativa; não concede acesso ao PostgreSQL.
SUPABASE_URL=https://<project-ref>.supabase.co
# Copie a conexão Session pooler em Connect no painel, preenchendo a senha.
DATABASE_URL=
# Opcional: certificado CA do projeto, quando necessário para validar TLS.
PG_CA_PATH=
# Caminho relativo à raiz do repositório.
DB_PATH=server/tarefas.db

# Produção: NODE_ENV=production e HTTPS na hospedagem.
PORT=3001
# Número exato de proxies confiáveis na frente do Express (opcional).
# TRUST_PROXY_HOPS=1
