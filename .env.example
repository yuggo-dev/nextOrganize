# URL informativa; não concede acesso ao PostgreSQL.
SUPABASE_URL=https://<project-ref>.supabase.co

# --- Scripts de manutenção da produção (npm run db:*) ---
# Conexão Session pooler copiada em Connect no painel, com a senha preenchida.
# O Express ignora esta variável: npm run dev continua usando o SQLite.
SUPABASE_DATABASE_URL=
# Certificado CA para validar TLS (scripts e servidor próprio).
PG_CA_PATH=supabase/certs/prod-ca-2021.crt

# --- Express em desenvolvimento local ---
# Caminho relativo à raiz do repositório.
DB_PATH=server/tarefas.db
PORT=3001

# --- Servidor próprio (segundo plano, sem uso hoje) ---
# Preenchida, faz o Express usar PostgreSQL em vez do SQLite.
# Deixe vazia no desenvolvimento.
# DATABASE_URL=
# Produção: NODE_ENV=production e HTTPS na hospedagem.
# NODE_ENV=production
# Número exato de proxies confiáveis na frente do Express.
# TRUST_PROXY_HOPS=1
